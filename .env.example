# ---------------------------------------------------------------------------
# AutoDev Agent — environment template
#
# Copy to `.env` at the repository root (the API and dashboard both read the
# same file when started through the pnpm scripts). Every variable below has a
# working default except OPENAI_API_KEY, which is optional.
# ---------------------------------------------------------------------------

# --- API -------------------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API.
# Both hosts are listed because the dashboard is opened over localhost in dev
# and over 127.0.0.1 by the Playwright suite.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Identity recorded on approval decisions.
OWNER_EMAIL=owner@autodev.local

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://autodev:autodev@127.0.0.1:5432/autodev

# Per-project workspaces (host directory). One subdirectory per project is
# bind-mounted at /workspace inside that project's Docker container.
WORKSPACES_ROOT=./workspaces

# --- Coding engine ---------------------------------------------------------
# auto           -> codex when OPENAI_API_KEY is set, otherwise scaffold
# scaffold       -> deterministic template generator, no credentials
# codex          -> Codex SDK coding engine (requires OPENAI_API_KEY)
# openai-agents  -> OpenAI Agents SDK file-tool engine (requires OPENAI_API_KEY)
AUTODEV_ENGINE=auto

# Optional model override for the model-backed engines.
# AUTODEV_MODEL=gpt-5-codex
# Optional OpenAI-compatible base URL.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Leave empty to run the deterministic scaffold engine only. The API reports
# key-gated engines as unavailable instead of pretending they can run.
OPENAI_API_KEY=

# Restart runs that were still marked running when the API restarted. Off by
# default so a restart never silently spends model credits.
AUTODEV_RESUME_ON_BOOT=false

# --- Docker sandbox --------------------------------------------------------
SANDBOX_IMAGE=autodev/workspace:latest
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=512
COMMAND_TIMEOUT_MS=300000
MAX_COMMANDS_PER_PROJECT=500

# --- Dashboard -------------------------------------------------------------
# Baked into the browser bundle at build/dev time.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
