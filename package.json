{
  "name": "autodev-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AutoDev Agent - autonomous AI software development platform",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev:api": "pnpm --filter @autodev/api dev",
    "dev:web": "pnpm --filter @autodev/web dev",
    "dev": "pnpm -r --parallel --if-present dev",
    "db:generate": "pnpm --filter @autodev/db generate",
    "db:migrate": "pnpm --filter @autodev/db migrate",
    "db:setup": "pnpm --filter @autodev/db setup",
    "sandbox:build": "docker build -t autodev/workspace:latest docker/workspace"
  }
}
